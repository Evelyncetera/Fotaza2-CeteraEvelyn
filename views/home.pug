extends layout

block content

    .card.mb-4
            .card-body
                h5 Buscar publicaciones

                form(
                    action="/buscar"
                    method="GET"
                )
                    .row
                        .col-md-5
                            input.form-control(
                                type="text"
                                name="titulo"
                                placeholder="Título"
                            )

                        .col-md-3
                            input.form-control(
                                type="date"
                                name="fecha"
                            )

                        .col-md-2
                            button.btn.btn-primary.w-100(
                                type="submit"
                            )
                                | Buscar

                        .col-md-2
                            a.btn.btn-secondary.w-100(
                                href="/"
                            )
                                | Limpiar

    h1.my-4 Feed
    a.btn.btn-success.mb-4(href="/publicaciones/crear") Nueva publicación

    .feed-grid
        each publicacion in publicaciones
            .card.shadow-sm
                .card-header.d-flex.justify-content-between.align-items-center
                    strong= publicacion.User.nombre
                    if usuarioLogueado && usuarioLogueado == publicacion.User.id
                        form(action=`/publicaciones/eliminar/${publicacion.id}` method="POST" class="m-0")
                            button.btn.btn-link.text-danger.p-0(type="submit")
                                i.bi.bi-trash

                if publicacion.imagenes && publicacion.imagenes.length > 0
                    img.card-img-top(src="/uploads/" + publicacion.imagenes[0].archivo alt="Foto")

                .card-body
                    h5.card-title= publicacion.titulo
                    p.card-text= publicacion.descripcion
                    
                    .d-flex.gap-2.align-items-center.mt-3
                        form(action="/interes/toggle" method="POST")
                            input(type="hidden" name="imagen_id" value=publicacion.imagenes[0].id)
                            button.btn.btn-outline-danger.btn-sm(type="submit")
                                i.bi.bi-heart-fill 
                                |  #{publicacion.imagenes[0].intereses ? publicacion.imagenes[0].intereses.length : 0}
                        
                        
                        form.d-flex.gap-1(action="/valoraciones/crear" method="POST")
                            input(type="hidden" name="imagen_id" value=publicacion.imagenes[0].id)
                            select.form-select.form-select-sm(name="valor" style="width: 60px;")
                                each val in [1,2,3,4,5]
                                    option(value=val)= val
                            button.btn.btn-outline-warning.btn-sm(type="submit") Valorar

                    h6.mt-3.border-top.pt-2 Comentarios
                    if publicacion.comentarios && publicacion.comentarios.length > 0
                        .overflow-auto(style="max-height: 100px;")
                            each comentario in publicacion.comentarios
                                p.small.mb-1 
                                    strong #{comentario.User.nombre}: 
                                    | #{comentario.texto}
                    else
                        p.small.text-muted No hay comentarios.

                    form(action="/comentarios/crear" method="POST" class="mt-2")
                        input(type="hidden" name="publicacion_id" value=publicacion.id)
                        input.form-control.form-control-sm.mb-1(type="text" name="texto" placeholder="Comentar..." required)
                        button.btn.btn-sm.btn-outline-primary(type="submit") Comentar

                .card-footer.text-muted.small
                    | Fecha: #{new Date(publicacion.createdAt).toLocaleDateString('es-AR')}
