extends layout

block content

    if mensaje
        .alert(
            class=`alert-${tipoMensaje}`
            role="alert"
        )
            = mensaje

    .card.mb-4
            .card-body
                h5 Buscar publicaciones

                form(
                    action="/buscar"
                    method="GET"
                )
                    .row
                        .col-md-5
                            input.form-control(
                                type="text"
                                name="titulo"
                                placeholder="Título"
                            )

                        .col-md-3
                            input.form-control(
                                type="date"
                                name="fecha"
                            )

                        .col-md-2
                            button.btn.btn-primary.w-100(
                                type="submit"
                            )
                                | Buscar

                        .col-md-2
                            a.btn.btn-secondary.w-100(
                                href="/"
                            )
                                | Limpiar

    h1.my-4 Feed
    a.btn.btn-success.mb-4(href="/publicaciones/crear") Nueva publicación

    .feed-grid
        each publicacion in publicaciones
            .card.shadow-sm
                .card-header.d-flex.justify-content-between.align-items-center
                    .d-flex.align-items-center.gap-2
                        strong= publicacion.User.nombre

                        if seguidos && seguidos.includes(publicacion.User.id)
                            span.badge.bg-success
                                | Siguiendo

                    .d-flex.align-items-center.gap-2

                        if usuarioLogueado && usuarioLogueado != publicacion.User.id

                            if seguidos.includes(publicacion.User.id)

                                form(
                                    action="/follower/dejar-seguir"
                                    method="POST"
                                    class="m-0"
                                )
                                    input(
                                        type="hidden"
                                        name="seguido_id"
                                        value=publicacion.User.id
                                    )

                                    button.btn.btn-outline-danger.btn-sm(
                                        type="submit"
                                    )
                                        | Dejar de seguir

                            else

                                form(
                                    action="/follower/seguir"
                                    method="POST"
                                    class="m-0"
                                )
                                    input(
                                        type="hidden"
                                        name="seguido_id"
                                        value=publicacion.User.id
                                    )

                                    button.btn.btn-primary.btn-sm(
                                        type="submit"
                                    )
                                        | Seguir

                        if usuarioLogueado && usuarioLogueado == publicacion.User.id

                            form(
                                action=`/publicaciones/eliminar/${publicacion.id}`
                                method="POST"
                                class="m-0"
                            )
                                button.btn.btn-link.text-danger.p-0(
                                    type="submit"
                                )
                                    i.bi.bi-trash

                if publicacion.imagenes && publicacion.imagenes.length > 0
                    img.card-img-top(src=publicacion.imagenes[0].archivo alt="Foto")

                    .card-body
                        h5.card-title= publicacion.titulo
                        p.card-text= publicacion.descripcion
                        
                        .d-flex.gap-2.align-items-center.mt-3.flex-wrap

                            form(action="/interes/toggle" method="POST")
                                input(
                                    type="hidden"
                                    name="imagen_id"
                                    value=publicacion.imagenes[0].id
                                )

                                button.btn.btn-outline-danger.btn-sm(
                                    type="submit"
                                )
                                    i.bi.bi-heart-fill
                                    |  #{publicacion.imagenes[0].intereses ? publicacion.imagenes[0].intereses.length : 0}


                            form.d-flex.gap-1(
                                action="/valoraciones/crear"
                                method="POST"
                            )
                                input(
                                    type="hidden"
                                    name="imagen_id"
                                    value=publicacion.imagenes[0].id
                                )

                                select.form-select.form-select-sm(
                                    name="valor"
                                    style="width: 60px;"
                                )
                                    each val in [1,2,3,4,5]
                                        option(value=val)= val

                                button.btn.btn-outline-warning.btn-sm(
                                    type="submit"
                                )
                                    | Valorar


                            if usuarioLogueado && usuarioLogueado != publicacion.User.id

                                form.d-flex.gap-1(
                                    action=`/denuncias/imagen/${publicacion.imagenes[0].id}`
                                    method="POST"
                                )

                                    select.form-select.form-select-sm(
                                        name="motivo"
                                        required
                                        style="width: 170px;"
                                    )
                                        option(value="") Motivo
                                        option(value="contenido_inapropiado") Contenido inapropiado
                                        option(value="violencia") Violencia
                                        option(value="spam") Spam
                                        option(value="otro") Otro

                                    input.form-control.form-control-sm(
                                        type="text"
                                        name="descripcion"
                                        placeholder="Descripción"
                                        style="width: 180px;"
                                    )

                                    button.btn.btn-outline-secondary.btn-sm(
                                        type="submit"
                                    )
                                        i.bi.bi-flag
                                        |  Denunciar

                        h6.mt-3.border-top.pt-3 Comentarios
                        if publicacion.imagenes[0].comentarios && publicacion.imagenes[0].comentarios.length > 0
                            .overflow-auto(style="max-height: 100px;")
                                each comentario in publicacion.imagenes[0].comentarios
                                    p.small.mb-1
                                        strong #{comentario.User.nombre}:
                                        | #{comentario.texto}
                        else
                            p.small.text-muted No hay comentarios.

                        form(action="/comentarios/crear" method="POST" class="mt-2")
                            input(type="hidden" name="imagen_id" value=publicacion.imagenes[0].id)
                            input.form-control.form-control-sm.mb-1(type="text" name="texto" placeholder="Comentar..." required)
                            button.btn.btn-sm.btn-outline-primary(type="submit") Comentar

                .card-footer.text-muted.small
                    | Fecha: #{new Date(publicacion.createdAt).toLocaleDateString('es-AR')}
