extends layout

block content

    h1 Inicio
    
    a.btn.btn-secondary.mb-3(
        href="/perfil"
    )
        | Mi perfil

    form(
        action="/buscar"
        method="GET"
        class="mb-4"
    )
        .mb-2
            input.form-control(
                type="text"
                name="titulo"
                placeholder="Buscar por título"
            )

        .mb-3
            input.form-control(
                type="date"
                name="fecha"
            )

        .d-flex.gap-2
            button.btn.btn-primary(
                type="submit"
            )
                | Buscar

        a.btn.btn-secondary(
            href="/"
        )
            | Limpiar

    hr

    a.btn.btn-primary.mb-3(
        href="/publicaciones/crear"
    ) Nueva publicación
    if publicaciones && publicaciones.length > 0
        each publicacion in publicaciones

            .card.mb-3
                .card-body

                    if publicacion.imagenes && publicacion.imagenes.length > 0
                        img(
                            src="/uploads/" + publicacion.imagenes[0].archivo
                            alt="Imagen"
                            width="300"
                        )
                        p.mt-2
                            strong ❤️ Interesados:
                            |  #{publicacion.imagenes[0].intereses ? publicacion.imagenes[0].intereses.length : 0}

                        form(
                            action="/interes/toggle"
                            method="POST"
                        )
                            input(
                                type="hidden"
                                name="imagen_id"
                                value=publicacion.imagenes[0].id
                            )
                            
                            - let promedio = 0

                            if publicacion.imagenes[0].valoraciones && publicacion.imagenes[0].valoraciones.length > 0
                                - let suma = 0
                                each valoracion in publicacion.imagenes[0].valoraciones
                                    - suma += valoracion.valor
                                - promedio = (suma / publicacion.imagenes[0].valoraciones.length).toFixed(1)
                                
                                
                                p
                                    strong Valoración:
                                    |  #{promedio}/5
                            else
                                p
                                    strong Valoración:
                                    |  Sin valoraciones

                            button.btn.btn-sm.btn-outline-danger(
                                type="submit"
                            )
                                | ❤️ Me interesa
                        form(
                            action="/valoraciones/crear"
                            method="POST"
                        )
                            input(
                                type="hidden"
                                name="imagen_id"
                                value=publicacion.imagenes[0].id
                            )
                            select(name="valor")
                                option(value="1") 1
                                option(value="2") 2
                                option(value="3") 3
                                option(value="4") 4
                                option(value="5") 5
                            button.btn.btn-sm.btn-warning(
                                type="submit"
                            )
                                | Valorar

                    h5= publicacion.titulo
                    p= publicacion.descripcion
                    p
                        strong Autor:
                        | #{publicacion.User.nombre}

                    if usuarioLogueado && usuarioLogueado == publicacion.User.id

                        form(
                            action=`/publicaciones/eliminar/${publicacion.id}`
                            method="POST"
                        )
                            button.btn.btn-danger.btn-sm(
                                type="submit"
                                onclick="return confirm('¿Eliminar publicación?')"
                            )
                                | Eliminar publicación

                    if usuarioLogueado && usuarioLogueado != publicacion.User.id
                        if seguidos.includes(publicacion.User.id)

                            form(
                                action="/follower/dejar-seguir"
                                method="POST"
                            )
                                input(
                                    type="hidden"
                                    name="seguido_id"
                                    value=publicacion.User.id
                                )

                                button.btn.btn-sm.btn-secondary(
                                    type="submit"
                                ) Dejar de seguir
                        else
                            form(
                                action="/follower/seguir"
                                method="POST"
                            )
                                input(
                                    type="hidden"
                                    name="seguido_id"
                                    value=publicacion.User.id
                                )

                                button.btn.btn-sm.btn-primary(
                                    type="submit"
                                ) Seguir
                    p
                        strong Fecha:
                        |  #{new Date(publicacion.createdAt).toLocaleDateString('es-AR')}
                    
                    h6 Comentarios

                    if publicacion.comentarios && publicacion.comentarios.length > 0
                        each comentario in publicacion.comentarios
                        
                            p   
                                strong #{comentario.User.nombre}:
                                |  #{comentario.texto}
                    else
                        p No hay comentarios todavía.
                    
                    form(
                        action="/comentarios/crear"
                        method="POST"
                    )
                        input(
                            type="hidden"
                            name="publicacion_id"
                            value=publicacion.id
                        )

                        input.form-control.mb-2(
                            type="text"
                            name="texto"
                            placeholder="Escribí un comentario..."
                            required
                        )

                        button.btn.btn-sm.btn-primary(
                            type="submit"
                        ) Comentar

    else
        p No hay publicaciones para mostrar.
    
    