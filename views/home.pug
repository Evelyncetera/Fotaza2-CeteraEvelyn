extends layout

block content

    if mensaje
        .alert(
            class=`alert-${tipoMensaje}`
            role="alert"
        )
            = mensaje

    if mostrarBusqueda !== false

    .card.mb-4
        .card-body

            h5 Buscar publicaciones

            form(
                action="/buscar"
                method="GET"
            )

                .row.g-2

                    .col-md-4

                        label.form-label
                            | Título

                        input.form-control(
                            type="text"
                            name="titulo"
                            placeholder="Ej: Atardecer"
                            value=filtros ? filtros.titulo : ''
                        )


                    .col-md-4

                        label.form-label
                            | Autor

                        input.form-control(
                            type="text"
                            name="autor"
                            placeholder="Nombre o apellido"
                            value=filtros ? filtros.autor : ''
                        )


                    .col-md-4

                        label.form-label
                            | Etiqueta

                        input.form-control(
                            type="text"
                            name="tag"
                            placeholder="Ej: paisaje"
                            value=filtros ? filtros.tag : ''
                        )


                    .col-md-4

                        label.form-label
                            | Fecha

                        input.form-control(
                            type="date"
                            name="fecha"
                            value=filtros ? filtros.fecha : ''
                        )


                    if usuarioLogueado

                        .col-md-4

                            label.form-label
                                | Licencia

                            select.form-select(
                                name="licencia"
                            )

                                option(
                                    value=""
                                    selected=!filtros || !filtros.licencia
                                )
                                    | Todas

                                option(
                                    value="sin_copyright"
                                    selected=filtros && filtros.licencia === 'sin_copyright'
                                )
                                    | Sin copyright

                                option(
                                    value="copyright"
                                    selected=filtros && filtros.licencia === 'copyright'
                                )
                                    | Con copyright


                    .col-md-4.d-flex.align-items-end.gap-2

                        button.btn.btn-primary.flex-grow-1(
                            type="submit"
                        )
                            i.bi.bi-search
                            |  Buscar

                        a.btn.btn-secondary(
                            href="/"
                        )
                            | Limpiar

    .d-flex.justify-content-between.align-items-center.my-4
        h1.mb-0
            = tituloFeed || 'Feed'

        if usuarioLogueado
            a.btn.btn-success(
                href="/publicaciones/crear"
            )
                i.bi.bi-plus-lg
                |  Nueva publicación


    .feed-grid
        each publicacion in publicaciones
            .card.shadow-sm.mb-4(
                id=`publicacion-${publicacion.id}`
            )

                .card-header.d-flex.justify-content-between.align-items-center
                    .d-flex.align-items-center.gap-2
                        strong= publicacion.User.nombre

                        if seguidos && seguidos.includes(publicacion.User.id)
                            span.badge.bg-success
                                | Siguiendo

                    .d-flex.align-items-center.gap-2

                        if usuarioLogueado && usuarioLogueado != publicacion.User.id

                            if seguidos.includes(publicacion.User.id)

                                form(
                                    action="/follower/dejar-seguir"
                                    method="POST"
                                    class="m-0"
                                )
                                    input(
                                        type="hidden"
                                        name="seguido_id"
                                        value=publicacion.User.id
                                    )

                                    button.btn.btn-outline-danger.btn-sm(
                                        type="submit"
                                    )
                                        | Dejar de seguir

                            else

                                form(
                                    action="/follower/seguir"
                                    method="POST"
                                    class="m-0"
                                )
                                    input(
                                        type="hidden"
                                        name="seguido_id"
                                        value=publicacion.User.id
                                    )

                                    button.btn.btn-primary.btn-sm(
                                        type="submit"
                                    )
                                        | Seguir

                        if usuarioLogueado && usuarioLogueado == publicacion.User.id

                            form(
                                action=`/publicaciones/eliminar/${publicacion.id}`
                                method="POST"
                                class="m-0"
                            )
                                button.btn.btn-link.text-danger.p-0(
                                    type="submit"
                                )
                                    i.bi.bi-trash

                // DATOS GENERALES
                .card-body
                    h5.card-title= publicacion.titulo

                    if publicacion.descripcion
                        p.card-text= publicacion.descripcion
                        
                    .d-flex.gap-2.align-items-center.mt-3.flex-wrap
                    
                    if publicacion.tags && publicacion.tags.length > 0

                        .d-flex.gap-1.flex-wrap.mb-2

                            each tag in publicacion.tags

                                span.badge.bg-secondary
                                    | ##{tag.nombre}
                                    
                // RECORREMOS TODAS LAS IMÁGENES
                if publicacion.imagenes && publicacion.imagenes.length > 0

                    .carousel.slide(
                        id=`carouselPublicacion-${publicacion.id}`
                        data-bs-interval="false"
                    )

                        .carousel-inner

                            each imagen, indice in publicacion.imagenes

                                .carousel-item(
                                    class=indice === 0 ? 'active' : ''
                                )

                                    img.d-block.w-100(
                                        src=imagen.archivo
                                        alt=`Imagen ${indice + 1} de ${publicacion.titulo}`
                                        style="height: 450px; object-fit: contain; background: #111;"
                                    )

                                    .p-3

                                        // INFO DE LA IMAGEN
                                        .d-flex.gap-2.mb-3

                                            span.badge.bg-secondary
                                                | Imagen #{indice + 1} de #{publicacion.imagenes.length}

                                            if imagen.licencia === 'copyright'
                                                span.badge.bg-warning.text-dark
                                                    | Copyright
                                            else
                                                span.badge.bg-success
                                                    | Sin copyright

                                        // PROMEDIO Y CANTIDAD DE VALORACIONES
                                        .d-flex.align-items-center.gap-2.mb-3

                                            if imagen.cantidadValoraciones > 0

                                                span.fw-semibold
                                                    i.bi.bi-star-fill.text-warning
                                                    |  #{imagen.promedioValoraciones}

                                                span.text-muted.small
                                                    | #{imagen.cantidadValoraciones} valoraciones

                                            else

                                                span.text-muted.small
                                                    | Sin valoraciones

                                        // ACCIONES DE ESTA IMAGEN
                                        if usuarioLogueado

                                            .d-flex.gap-2.align-items-center.flex-wrap.mb-3

                                                // ME INTERESA
                                                if usuarioLogueado != publicacion.User.id

                                                    form(
                                                        action="/interes/toggle"
                                                        method="POST"
                                                    )
                                                        input(
                                                            type="hidden"
                                                            name="imagen_id"
                                                            value=imagen.id
                                                        )

                                                        button.btn.btn-outline-danger.btn-sm(
                                                            type="submit"
                                                        )
                                                            i.bi.bi-heart-fill
                                                            |  #{imagen.intereses ? imagen.intereses.length : 0}


                                                // VALORACIÓN
                                                if usuarioLogueado != publicacion.User.id

                                                    - const yaValoro = imagen.valoraciones && imagen.valoraciones.some(v => v.usuario_id == usuarioLogueado)

                                                    if yaValoro

                                                        span.badge.bg-light.text-dark.border
                                                            i.bi.bi-check-circle
                                                            |  Ya valoraste esta imagen

                                                    else

                                                        form.d-flex.gap-1(
                                                            action="/valoraciones/crear"
                                                            method="POST"
                                                        )

                                                            input(
                                                                type="hidden"
                                                                name="imagen_id"
                                                                value=imagen.id
                                                            )

                                                            select.form-select.form-select-sm(
                                                                name="valor"
                                                                required
                                                                style="width: 70px;"
                                                            )
                                                                each val in [1,2,3,4,5]
                                                                    option(value=val)= val

                                                            button.btn.btn-outline-warning.btn-sm(
                                                                type="submit"
                                                            )
                                                                | Valorar


                                                // DENUNCIA DE ESTA IMAGEN
                                                if usuarioLogueado != publicacion.User.id

                                                    form.d-flex.gap-1.flex-wrap(
                                                        action=`/denuncias/imagen/${imagen.id}`
                                                        method="POST"
                                                    )

                                                        select.form-select.form-select-sm(
                                                            name="motivo"
                                                            required
                                                            style="width: 170px;"
                                                        )
                                                            option(value="") Motivo
                                                            option(value="contenido_inapropiado") Contenido inapropiado
                                                            option(value="violencia") Violencia
                                                            option(value="spam") Spam
                                                            option(value="otro") Otro

                                                        input.form-control.form-control-sm(
                                                            type="text"
                                                            name="descripcion"
                                                            placeholder="Descripción"
                                                            required
                                                            style="width: 180px;"
                                                        )

                                                        button.btn.btn-outline-secondary.btn-sm(
                                                            type="submit"
                                                        )
                                                            i.bi.bi-flag
                                                            |  Denunciar


                                        // COMENTARIOS DE ESTA IMAGEN
                                        .d-flex.justify-content-between.align-items-center.mt-3.border-top.pt-3.mb-2

                                            h6.mb-0
                                                | Comentarios

                                            if usuarioLogueado && usuarioLogueado == publicacion.User.id

                                                form(
                                                    action=`/imagenes/${imagen.id}/comentarios/toggle`
                                                    method="POST"
                                                )
                                                    if imagen.comentarios_abiertos
                                                        button.btn.btn-outline-danger.btn-sm(
                                                            type="submit"
                                                        )
                                                            i.bi.bi-lock
                                                            |  Cerrar comentarios
                                                    else

                                                        button.btn.btn-outline-success.btn-sm(
                                                            type="submit"
                                                        )
                                                            i.bi.bi-unlock
                                                            |  Abrir comentarios

                                        if imagen.comentarios && imagen.comentarios.length > 0

                                            .overflow-auto(
                                                style="max-height: 180px;"
                                            )
                                                each comentario in imagen.comentarios

                                                    .mb-2
                                                        p.small.mb-1
                                                            strong #{comentario.User.nombre}:
                                                            |  #{comentario.texto}

                                                        if usuarioLogueado && usuarioLogueado != comentario.User.id && comentario.User.id != publicacion.User.id

                                                            form.d-flex.gap-1.mb-2(
                                                                action=`/denuncias/comentario/${comentario.id}`
                                                                method="POST"
                                                            )
                                                                select.form-select.form-select-sm(
                                                                    name="motivo"
                                                                    required
                                                                    style="width: 150px;"
                                                                )
                                                                    option(value="") Motivo
                                                                    option(value="contenido_inapropiado") Contenido inapropiado
                                                                    option(value="spam") Spam
                                                                    option(value="acoso") Acoso
                                                                    option(value="otro") Otro

                                                                input.form-control.form-control-sm(
                                                                    type="text"
                                                                    name="descripcion"
                                                                    placeholder="Descripción"
                                                                )

                                                                button.btn.btn-outline-danger.btn-sm(
                                                                    type="submit"
                                                                )
                                                                    i.bi.bi-flag
                                        else
                                            p.small.text-muted
                                                | No hay comentarios.


                                        // NUEVO COMENTARIO
                                        if usuarioLogueado

                                            if imagen.comentarios_abiertos

                                                form.mt-2(
                                                    action="/comentarios/crear"
                                                    method="POST"
                                                )

                                                    input(
                                                        type="hidden"
                                                        name="imagen_id"
                                                        value=imagen.id
                                                    )

                                                    input.form-control.form-control-sm.mb-1(
                                                        type="text"
                                                        name="texto"
                                                        placeholder="Comentar..."
                                                        required
                                                    )

                                                    button.btn.btn-sm.btn-outline-primary(
                                                        type="submit"
                                                    )
                                                        | Comentar

                                            else

                                                p.small.text-muted.mt-2
                                                    i.bi.bi-lock
                                                    |  Los comentarios están cerrados para esta imagen.


                        // FLECHAS SOLO SI HAY MÁS DE UNA IMAGEN
                        if publicacion.imagenes.length > 1

                            .d-flex.justify-content-between.align-items-center.px-3.pb-3

                                button.btn.btn-outline-secondary.btn-sm(
                                    type="button"
                                    data-bs-target=`#carouselPublicacion-${publicacion.id}`
                                    data-bs-slide="prev"
                                    title="Imagen anterior"
                                )
                                    i.bi.bi-chevron-left
                                    |  Anterior

                                button.btn.btn-outline-secondary.btn-sm(
                                    type="button"
                                    data-bs-target=`#carouselPublicacion-${publicacion.id}`
                                    data-bs-slide="next"
                                    title="Imagen siguiente"
                                )
                                    | Siguiente 
                                    i.bi.bi-chevron-right

                else

                    .card-body
                        p.text-muted
                            | Esta publicación no tiene imágenes disponibles.