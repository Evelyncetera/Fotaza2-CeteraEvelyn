extends layout

block content

    .row.justify-content-center
        .col-md-8.col-lg-6

            .card.shadow-sm
                .card-body

                    h1.text-center.mb-4 Crear publicación

                    form(
                        action="/publicaciones/crear"
                        method="POST"
                        enctype="multipart/form-data"
                    )

                        .mb-3
                            label.form-label Título
                            input.form-control(
                                type="text"
                                name="titulo"
                                required
                            )

                        .mb-3
                            label.form-label Descripción
                            textarea.form-control(
                                name="descripcion"
                                rows="4"
                            )

                        .mb-3
                            label.form-label Seleccionar imagen
                            input.form-control(
                                type="file"
                                name="imagen"
                                accept="image/*"
                            )

                        .form-check.mb-3
                            input.form-check-input(
                                type="checkbox"
                                name="comentarios_abiertos"
                                checked
                            )
                            label.form-check-label
                                | Permitir comentarios

                        button.btn.btn-success.w-100(
                            type="submit"
                        )
                            | Publicar