extends ../layout

block content

    if mensaje
        .alert(
            class=`alert-${tipoMensaje}`
            role="alert"
        )
            = mensaje
            
    .container
        .row.justify-content-center
            .col-md-6.col-lg-4
                .card.shadow
                    .card-body
                        h2.text-center.mb-4 Iniciar sesión
                        form(action="/auth/login" method="POST")
                            .mb-3
                                label.form-label Email
                                input.form-control(type="email" name="email" required)
                            .mb-3
                                label.form-label Contraseña
                                input.form-control(type="password" name="password" required)
                            button.btn.btn-primary.w-100(type="submit") Ingresar
                        
                        p.text-center.mt-3
                            small ¿No tienes cuenta? 
                                a(href="/auth/registro") Regístrate