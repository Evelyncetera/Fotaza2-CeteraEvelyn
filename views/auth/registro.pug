extends ../layout

block content 
    .row.justify-content-center
        .col-md-6.col-lg-5 
            .card.shadow-sm.mt-4
                .card-header.bg-white.text-center.py-3
                    h3.mb-0 Registrarse
                    p.text-muted.mb-0 Únete a Fotaza 2
        
                .card-body.p-4
                    form(action="/auth/registro" method="POST")
            
                        .row
                            .col-md-6.mb-3
                                label.form-label(for="nombre") Nombre
                                input#nombre.form-control(type="text" name="nombre" required placeholder="Ej: Juan")
                    
                            .col-md-6.mb-3
                                label.form-label(for="apellido") Apellido
                                input#apellido.form-control(type="text" name="apellido" required placeholder="Ej: Pérez")

                        .mb-3
                            label.form-label(for="email") Correo Electrónico
                            input#email.form-control(type="email" name="email" required placeholder="tu@email.com")

                        .mb-3
                            label.form-label(for="password") Contraseña
                            input#password.form-control(type="password" name="password" required)
                            .form-text Mínimo 6 caracteres.

                        .mb-4
                            label.form-label(for="repetir_password") Repetir Contraseña
                            input#repetir_password.form-control(type="password" name="repetir_password" required)

                        .d-grid
                            button.btn.btn-primary.btn-lg(type="submit") Registrarse
            
                .card-footer.text-center.bg-white.py-3
                    span ¿Ya tienes una cuenta? 
                    a.text-decoration-none(href="/auth/login") Inicia sesión aquí