doctype html 
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Fotaza 2 | HOME
        
        link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet")
        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
        link(rel="stylesheet", href="/style.css")

    body.bg-light
        nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4
            .container.main-container

                nav.navbar.navbar-fotaza
                    a.logo-fotaza(href="/")
                        | Fotaza 2

                .navbar-nav.me-auto

                .navbar-nav

                    if usuarioLogueado

                        li.nav-item.dropdown
                            a.nav-link.dropdown-toggle(
                                href="#"
                                role="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                            )
                                | Mi cuenta

                            ul.dropdown-menu.dropdown-menu-end
                                li
                                    a.dropdown-item(href="/perfil")
                                        i.bi.bi-person
                                        |  Mi perfil
                                li
                                    a.dropdown-item(href="/follower/seguidos")
                                        i.bi.bi-people
                                        |  Publicaciones de Usuarios que sigo
                                li
                                    a.dropdown-item(
                                        href="/interes/recibidos"
                                    )
                                        i.bi.bi-heart
                                        |  Personas interesadas
                                li
                                    a.dropdown-item(href="/mensajes")
                                        i.bi.bi-chat-dots
                                        |  Mis conversaciones
                                li
                                    a.dropdown-item(href="/denuncias/comentarios")
                                        i.bi.bi-flag
                                        |  Comentarios denunciados

                                if usuarioRol === 'validador'
                                    li
                                        a.dropdown-item(href="/moderacion")
                                            i.bi.bi-shield-check
                                            |  Moderación

                                li
                                    hr.dropdown-divider
                                li
                                    a.dropdown-item(href="/auth/logout")
                                        i.bi.bi-box-arrow-right
                                        |  Cerrar sesión
                    else

                        a.nav-link(
                            href="/auth/login"
                        )
                            | Iniciar sesión

                        a.nav-link(
                            href="/auth/registro"
                        )
                            | Registrarse
        
        

        main.container.mt-5
            block content

        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")