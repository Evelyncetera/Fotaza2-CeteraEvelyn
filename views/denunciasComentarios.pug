extends layout

block content

    h1.mb-4 Denuncia de Comentarios

    if mensaje
        .alert(
            class=`alert-${tipoMensaje}`
            role="alert"
        )
            = mensaje

    h2.mb-3 Denuncias en mis publicaciones

        if denunciasRecibidas.length === 0
            p.text-muted No hay comentarios denunciados en tus publicaciones.

        else
            each denuncia in denunciasRecibidas

                .card.mb-3.shadow-sm
                    .card-body

                        p
                            strong Comentario:
                            |  #{denuncia.Comentario.texto}

                        p
                            strong Motivo:
                            |  #{denuncia.motivo}

                        if denuncia.descripcion
                            p
                                strong Descripción:
                                |  #{denuncia.descripcion}

                        p
                            strong Denunciado por:
                            |  #{denuncia.User.nombre}

                        form(
                            action=`/denuncias/comentarios/eliminar/${denuncia.Comentario.id}`
                            method="POST"
                        )
                            button.btn.btn-danger.btn-sm(
                                type="submit"
                            )
                                | Eliminar comentario