extends layout

block content

    .d-flex.justify-content-between.align-items-center.mb-3

    h1 Mi Perfil

    p
        strong Nombre:
        |  #{usuario.nombre}

    p
        strong Apellido:
        |  #{usuario.apellido}

    p
        strong Email:
        |  #{usuario.email}

    p
        strong Seguidores:
        |  #{seguidores}

    p
        strong Siguiendo:
        |  #{seguidos}

    p
        strong Publicaciones:
        |  #{publicaciones.length}

    hr

    h2.mb-4 Mis publicaciones

    .feed-grid

        each publicacion in publicaciones

            .card.shadow-sm

                if publicacion.imagenes && publicacion.imagenes.length > 0
                    img.card-img-top(
                        src=publicacion.imagenes[0].archivo
                        alt=publicacion.titulo
                    )

                .card-body

                    h5.card-title= publicacion.titulo

                    .d-flex.gap-3.mb-3

                        span
                            i.bi.bi-heart-fill.text-danger
                            |  #{publicacion.imagenes[0].intereses.length}

                        p
                            i.bi.bi-star-fill.text-warning
                            |  #{publicacion.promedioValoraciones}

                        span
                            i.bi.bi-chat-left-text
                            |  #{publicacion.comentarios.length}

                    form(
                        action=`/publicaciones/eliminar/${publicacion.id}`
                        method="POST"
                    )
                        button.btn.btn-danger.btn-sm
                            i.bi.bi-trash
                            |  Eliminar